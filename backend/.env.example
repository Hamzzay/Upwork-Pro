PORT=3000
NODE_ENV=development

# MySQL (XAMPP). Create a dedicated user, do not use root. See scripts/migrate.ts
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=upwork_gate
DB_USER=upwork_gate
DB_PASSWORD=

# LLM: 'mock' (default, no quota) or 'claude-cli' (the pinned Claude Code CLI)
LLM_PROVIDER=mock
# Anthropic directly (Claude subscription): long-lived token from `claude setup-token`.
# When set, LLM_BASE_URL / LLM_API_KEY are ignored and LLM_MODEL defaults to claude-sonnet-5-5.
LLM_OAUTH_TOKEN=
# Or GLM through Z.ai: leave LLM_OAUTH_TOKEN empty and fill these.
LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_CONCURRENCY=3
LLM_TIMEOUT_MS=300000

# Upwork API (not wired yet: see src/upwork/client.ts)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=

# First admin, used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
