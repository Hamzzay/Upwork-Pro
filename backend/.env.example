PORT=3000
NODE_ENV=development

# MySQL (XAMPP). Create a dedicated user, do not use root. See scripts/migrate.ts
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=upwork_gate
DB_USER=upwork_gate
DB_PASSWORD=

# LLM: 'mock' (default, no quota) or 'claude-cli' (GLM through Z.ai)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash[1m]
LLM_CONCURRENCY=3
LLM_TIMEOUT_MS=300000

# Upwork API (not wired yet: see src/upwork/client.ts)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=

# First admin, used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
