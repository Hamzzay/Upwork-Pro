PORT=3000
NODE_ENV=development

# MySQL (XAMPP). Create a dedicated user, do not use root. See scripts/migrate.ts
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=upwork_gate
DB_USER=upwork_gate
DB_PASSWORD=

# LLM: 'mock' (default, no quota) or 'claude-cli' (real AI). With claude-cli, an admin picks GLM, Claude or GPT in Settings.
# Each provider's key lives here only; Settings just shows whether it was found.
LLM_PROVIDER=mock
# GLM through Z.ai
LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash[1m]
# Claude (Anthropic): an API key, or a subscription token from `claude setup-token` (the key wins if both are set)
ANTHROPIC_API_KEY=
LLM_OAUTH_TOKEN=
# GPT (OpenAI API). OPENAI_BASE_URL is only for a proxy or a test server.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_CONCURRENCY=3
LLM_TIMEOUT_MS=300000

# Upwork API (not wired yet: see src/upwork/client.ts)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=

# First admin, used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
